APP_NAME="CRYPTOISK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_TIMEZONE=Europe/Minsk
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The trading app shares the Krayin CRM database. It creates only trading_*,
# withdrawal_* and price_history tables. The single exception is client
# self-registration, which inserts a CRM user, role, person and lead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=krayin_crm
DB_USERNAME=root
DB_PASSWORD=

# Dedicated migrations table, isolated from the CRM "migrations" table.
DB_MIGRATIONS_TABLE=trading_migrations

# Use the file driver so no "sessions"/"cache" tables are added to the
# shared database. The cookie name must differ from the CRM one, because
# cookies are not isolated by port.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=trading_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=trading

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Trading
TRADING_DEFAULT_SYMBOL=BTC
TRADING_VS_CURRENCY=usd
TRADING_HISTORY_DAYS=7
# Credited to an existing CRM user on the first dashboard visit
# (0 = the operator funds the account from the CRM card instead)
TRADING_INITIAL_BALANCE=0
TRADING_PROTECT_SHARED_DB=true

# Client self-registration (/register): starting balance of a new client in USD
TRADING_REGISTRATION_INITIAL_BALANCE=0
# CRM role of a client: pin an id, or leave 0 to reuse/create the named role
# (the role has no permissions, so a client cannot open any CRM section)
TRADING_CLIENT_ROLE_ID=0
TRADING_CLIENT_ROLE_NAME="Trading Client"

# Withdrawals (an operator approves every request in the CRM)
TRADING_WITHDRAWAL_MIN_AMOUNT=10
TRADING_WITHDRAWAL_MAX_AMOUNT=1000000
# Deposits (staged here, credited only when an operator approves in the CRM)
TRADING_DEPOSIT_MIN_AMOUNT=10
TRADING_DEPOSIT_MAX_AMOUNT=1000000
# Same value as WITHDRAWAL_CARD_KEY in the CRM: it reads the card number
WITHDRAWAL_CARD_KEY=

# Positions: smallest position in USD (0.01 keeps a dust trade out of the book)
TRADING_POSITION_MIN_USD=0.01
# Saved cards: how many days an unused card stays in the cabinet (0 = forever)
TRADING_CARD_HISTORY_DAYS=0

# CoinGecko (free public API, no key required)
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_TIMEOUT=15
COINGECKO_RETRY_TIMES=2
COINGECKO_RETRY_DELAY_MS=1500


# Krayin CRM bridge (must match CRM_TRADING_TOKEN in the CRM)
TRADING_BRIDGE_TOKEN=
TRADING_BRIDGE_MAX_AMOUNT=1000000
